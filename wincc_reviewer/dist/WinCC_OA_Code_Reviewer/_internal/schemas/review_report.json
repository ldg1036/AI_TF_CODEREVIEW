{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review_report.json",
  "title": "ReviewReport",
  "description": "리뷰 리포트 스키마 (09_구현착수_패키지_계약.md §4)",
  "type": "object",
  "required": ["schema_version", "run_id", "rule_source", "files", "violations", "errors", "metrics"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "스키마 버전"
    },
    "run_id": {
      "type": "string",
      "description": "실행 ID"
    },
    "rule_source": {
      "type": "string",
      "description": "룰 원천 파일 경로"
    },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "검사 대상 파일 목록"
    },
    "violations": {
      "type": "array",
      "items": { "$ref": "violation.json" },
      "description": "위반 사항 목록"
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "parse_status.json" },
      "description": "파싱 실패 파일 목록"
    },
    "metrics": {
      "type": "object",
      "description": "실행 지표",
      "properties": {
        "timings_ms": { "type": "object" },
        "cache_hits": { "type": "object" },
        "cache_misses": { "type": "object" },
        "file_count": { "type": "integer" },
        "violation_count": { "type": "integer" }
      }
    },
    "ruleset_version": { "type": "string" },
    "ruleset_source_sha256": { "type": "string" },
    "app_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
