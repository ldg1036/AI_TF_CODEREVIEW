{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "parse_status.json",
  "title": "ParseStatus",
  "description": "파싱 상태 스키마 (09_구현착수_패키지_계약.md §4)",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["parsed", "parse_failed", "unsupported"],
      "description": "파싱 상태"
    },
    "file": {
      "type": "string",
      "description": "파일 경로"
    },
    "error_message": {
      "type": ["string", "null"],
      "description": "실패 사유 (parse_failed일 때)"
    }
  },
  "additionalProperties": false
}
